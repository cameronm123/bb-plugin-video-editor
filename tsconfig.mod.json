{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [],
    "paths": {
      "claude-code/testing": [
        "./hooks/claude-code-testing.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "hooks/register.ts",
    "hooks/video.ts",
    "hooks/video.test.ts",
    "hooks/claude-code-testing.ts",
    "core/types.ts",
    "core/operations.ts",
    "core/digest.ts",
    "core/ffmpeg.ts"
  ]
}
